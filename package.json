{
  "name": "pl",
  "version": "1.0.0",
  "description": "Express PostgreSQL TypeScript Application",
  "main": "dist/src/app.js",
  "scripts": {
    "start": "node dist/src/app.js",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "test": "jest",
    "dev": "docker compose --profile dev up --build app-dev worker-dev",
    "worker": "node dist/src/worker.js",
    "worker:dev": "ts-node-dev --respawn --poll --transpile-only --require tsconfig-paths/register src/worker.ts",
    "dev:down": "docker compose --profile dev down",
    "fresh": "docker compose --profile dev down -v && docker compose --profile dev up --build app-dev worker-dev",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:migrate": "docker compose run --rm migrate",
    "docker:logs": "docker compose logs -f --tail=50",
    "lint": "eslint \"src/**/*.ts\"",
    "prepare": "husky install || true",
    "migrate:new": "ts-node scripts/create-migration.ts",
    "migrate:up": "npx knex migrate:latest --env development",
    "migrate-up:once": "npx knex migrate:up --env development && ts-node scripts/generate-db-types.ts",
    "migrate-up:all": "npx knex migrate:latest --env development && ts-node scripts/generate-db-types.ts",
    "migrate-down:once": "npx knex migrate:down --env development && ts-node scripts/generate-db-types.ts",
    "migrate-down:all": "npx knex migrate:rollback --all --env development && ts-node scripts/generate-db-types.ts",
    "migrate-up:dry-once": "npx knex migrate:up --env development --dry-run && ts-node scripts/generate-db-types.ts",
    "migrate-down:dry-once": "npx knex migrate:down --env development --dry-run && ts-node scripts/generate-db-types.ts",
    "create:endpoint": "ts-node scripts/create-endpoint.ts",
    "create:helper": "ts-node scripts/create-helper.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.8.4",
    "bullmq": "^6.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "knex": "^3.1.0",
    "kysely": "^0.27.6",
    "pg": "^8.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/inquirer": "^8.2.13",
    "@types/jest": "^29.5.11",
    "@types/lodash": "^4.17.25",
    "@types/node": "^20.17.27",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "chalk": "^4.1.2",
    "eslint": "^8.57.1",
    "husky": "^8.0.3",
    "inquirer": "^8.2.7",
    "jest": "^29.7.0",
    "lodash": "^4.18.1",
    "prettier": "^3.5.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2"
  }
}
