DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=database
DB_PORT=5434

REDIS_HOST=localhost
REDIS_PORT=6379

# Background worker cadence
# OUTBOX_RELAY_INTERVAL_MS=1000
# PAYOUT_SWEEP_INTERVAL_MS=30000

# Omit to use the fake payment provider, which logs instead of moving money
# PAYSTACK_SECRET_KEY=

NODE_ENV=development
PORT=7070
API_VERSION=v1

# Test suite runs against a separate database on the same Postgres instance
TEST_DB_NAME=database_test

# Host port the app container publishes on. Defaults to PORT.
# APP_PORT=7070

# APP_ENVIRONMENT=PRODUCTION
# CORS_ORIGIN=http://localhost:5173
